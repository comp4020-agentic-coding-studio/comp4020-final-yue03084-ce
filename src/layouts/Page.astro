---
import "../styles.css";
import { NOTE_COLOURS, SITE_NAME } from "../lib/limits";

interface Props {
  // the page's own name; leave it out for the home page, which is just the site
  title?: string;
}
const { title } = Astro.props;
const fullTitle = title && title !== SITE_NAME ? `${title} · ${SITE_NAME}` : SITE_NAME;
const here = Astro.url.pathname;
// the note colours' shades, from their one definition (CLAUDE.md: "One fact, one piece of code")
const shades = (theme: "light" | "dark") =>
  Object.entries(NOTE_COLOURS)
    .map(([key, c]) => `--c-${key}: ${c[theme]};`)
    .join(" ");
// the dark shades follow the system setting, like the rest of the palette in styles.css
const colourCss = `:root { ${shades("light")} } @media (prefers-color-scheme: dark) { :root { ${shades("dark")} } }`;
const links = [
  { href: "/", label: "Put down for now" },
  { href: "/working/", label: "Working on it" },
  { href: "/enough/", label: "Call it enough" },
  { href: "/mine/", label: "Mine" },
];
// the README lives at /readme/ (the course's markers start there), linked from
// the foot of every page rather than the nav
const about = "/readme/";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Lora:wght@500;600&family=Raleway:wght@400;600&display=swap"
    />
    <style set:html={colourCss}></style>
  </head>
  <body>
    <!-- the crayon texture the time bar's strokes use -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="crayon">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" result="grain" />
        <feDisplacementMap in="SourceGraphic" in2="grain" scale="3" />
      </filter>
    </svg>
    <nav aria-label="site">
      {
        links.map((l) => (
          // a page inside a section (Mine's two pages) still marks the section
          <a href={l.href} aria-current={here === l.href || (l.href !== "/" && here.startsWith(l.href)) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <a href={about} aria-current={here === about ? "page" : undefined}>About this project</a>
    </footer>
  </body>
</html>

---
import "../styles.css";
import { NOTE_COLOURS } from "../lib/limits";

interface Props {
  title: string;
}
const { title } = Astro.props;
const here = Astro.url.pathname;
// the note colours' shades, from their one definition (CLAUDE.md: "One fact, one piece of code")
const shades = (theme: "light" | "dark") =>
  Object.entries(NOTE_COLOURS)
    .map(([key, c]) => `--c-${key}: ${c[theme]};`)
    .join(" ");
const colourCss = `:root { ${shades("light")} }`;
const links = [
  { href: "/", label: "Stopping now" },
  { href: "/enough/", label: "Say enough" },
  { href: "/mine/", label: "Mine" },
  { href: "/readme/", label: "About" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Lora:wght@500;600&family=Raleway:wght@400;600&display=swap"
    />
    <style set:html={colourCss}></style>
  </head>
  <body>
    <nav aria-label="site">
      {links.map((l) => <a href={l.href} aria-current={here === l.href ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

---
import "../styles.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const here = Astro.url.pathname;
const links = [
  { href: "/", label: "Stopping now" },
  { href: "/enough/", label: "Say enough" },
  { href: "/mine/", label: "Mine" },
  { href: "/readme/", label: "About" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="site">
      {links.map((l) => <a href={l.href} aria-current={here === l.href ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

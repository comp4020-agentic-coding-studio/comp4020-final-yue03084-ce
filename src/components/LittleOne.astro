---
import { CARRY_SECONDS, NOTE_COLOURS, TOWER_MAX } from "../lib/limits";
import type { WorkView } from "../lib/work";
import { tiredness } from "../lib/worktime";

// The little one: works alongside you on Working on it, only ever for its
// owner. Working, it walks to the pile, picks up a block, carries it to the
// day's crooked tower and puts it on top, then goes back for another: the
// tower grows while you watch. Past your alarm it slows down, the blocks it
// carries get smaller and it yawns (a metaphor, limits.ts), so the tower
// grows more slowly. On a break it has tea, stretches or naps. Sleepy, never
// sad. The tower is a drawing of today, never a number. Decoration, hidden
// from screen readers; the text beside it says what's going on. With reduced
// motion it holds a still pose and the tower stays as today's work left it.
interface Props {
  view: WorkView;
}
const { view } = Astro.props;
const t = view.state === "resting" ? tiredness(0) : view.tiredness;
const pose =
  view.state === "resting"
    ? view.restKind === "nap"
      ? "nap"
      : view.restKind === "move" || view.restKind === "walk"
        ? "stretch"
        : "tea"
    : "work";
---

<figure
  class="little-one"
  aria-hidden="true"
  data-state={view.state}
  data-pose={pose}
  data-sleepy-from={view.sleepyFrom ?? ""}
  data-carry={view.carry}
  data-tower={view.tower}
  data-tower-max={TOWER_MAX}
  data-carry-seconds={CARRY_SECONDS}
  data-colours={JSON.stringify(Object.keys(NOTE_COLOURS))}
  data-yawning={String(t.yawning)}
  data-speed={t.speed}
  data-block={t.block}
>
  <svg viewBox="0 20 320 160" role="presentation" focusable="false">
    <line class="ground" x1="10" y1="170.5" x2="310" y2="170.5" />
    <!-- the pile it fetches blocks from -->
    <g class="pile">
      <rect class="tblock c-mist" x="18" y="159" width="24" height="10" rx="2" transform="rotate(-3 30 164)" />
      <rect class="tblock c-sage" x="22" y="149" width="20" height="10" rx="2" transform="rotate(4 32 154)" />
      <rect class="tblock c-rose" x="42" y="160" width="18" height="9" rx="2" transform="rotate(2 51 164)" />
      <rect class="tblock c-clay" x="30" y="139" width="16" height="10" rx="2" transform="rotate(-5 38 144)" />
    </g>
    <!-- the day's tower; the script lays its blocks, starting from today's work -->
    <g class="tower"></g>

    <!-- working: the script walks it between the pile and the tower -->
    <g class="worker">
      <g class="walker">
        <g class="body">
          <circle class="head" cx="0" cy="-52" r="8" />
          <path class="mouth" d="M-3 -49 q3 2 6 0" />
          <ellipse class="yawn" cx="0" cy="-49" rx="2.2" ry="2.8" />
          <path class="torso" d="M0 -44 L0 -22" />
          <path class="legs" d="M0 -22 L-7 0 M0 -22 L7 0" />
          <path class="arms" d="M0 -38 L13 -44 M0 -38 L13 -34" />
          <rect class="carried" x="10" y="-50" width="18" height="10" rx="2" />
        </g>
      </g>
    </g>

    <!-- resting: tea, a stretch, or a nap -->
    <g class="rester tea">
      <circle class="head" cx="70" cy="134" r="8" />
      <path class="mouth" d="M67 137 q3 2 6 0" />
      <path d="M70 142 L70 157 M70 157 L86 157 L88 168 M70 157 L58 168 M70 147 L82 151" />
      <path class="cup" d="M82 146 h8 v7 a3 3 0 0 1 -3 3 h-2 a3 3 0 0 1 -3 -3 z" />
      <path class="steam" d="M85 141 q-2 -4 0 -7 M88 142 q2 -4 0 -7" />
    </g>
    <g class="rester stretch">
      <circle class="head" cx="70" cy="110" r="8" />
      <path class="mouth" d="M67 113 q3 2 6 0" />
      <path d="M70 118 L70 144 M70 144 L62 168 M70 144 L78 168 M70 125 L58 103 M70 125 L82 103" />
    </g>
    <g class="rester nap">
      <circle class="head" cx="56" cy="161" r="8" />
      <path d="M64 163 L102 163 M102 163 L114 169 M102 163 L116 161 M74 163 L66 153" />
      <path class="zz" d="M74 139 h7 l-7 7 h7 M86 129 h5 l-5 5 h5" />
    </g>
  </svg>
</figure>

<style>
  .little-one {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
  }

  .ground {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* :global, because the script makes the tower's blocks and sets the carried
     block's colour, and scoped styles don't reach what a script creates */
  .little-one :global(.c-sage) { fill: var(--c-sage); }
  .little-one :global(.c-rose) { fill: var(--c-rose); }
  .little-one :global(.c-mist) { fill: var(--c-mist); }
  .little-one :global(.c-clay) { fill: var(--c-clay); }

  .worker path,
  .worker circle,
  .rester path,
  .rester circle {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .head {
    fill: var(--card) !important;
  }

  .mouth {
    stroke-width: 1.4 !important;
  }

  .yawn {
    fill: var(--fg);
    opacity: 0;
  }

  .carried {
    fill: var(--c-clay);
  }

  /* a block that's just been put down settles onto the tower */
  .tower :global(.landed) {
    animation: settle 420ms ease-out;
  }

  @keyframes settle {
    0% { transform: translateY(-6px); }
    70% { transform: translateY(1px); }
    100% { transform: translateY(0); }
  }

  .cup {
    fill: var(--c-mist) !important;
    stroke-width: 1.5 !important;
  }

  .steam,
  .zz {
    stroke: var(--muted) !important;
    stroke-width: 1.3 !important;
    animation: drift 3s ease-in-out infinite;
  }

  .rester {
    display: none;
  }

  [data-state="resting"] .worker {
    display: none;
  }

  [data-pose="tea"] .rester.tea,
  [data-pose="stretch"] .rester.stretch,
  [data-pose="nap"] .rester.nap {
    display: inline;
  }

  /* a little bob in the step while it walks */
  .walker.walking .body {
    animation: step 0.5s ease-in-out infinite;
  }

  @keyframes step {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1.5px); }
  }

  /* sleepy: a slow yawn now and then, never a frown */
  [data-yawning="true"] .yawn {
    animation: yawn 7s ease-in-out infinite;
  }

  [data-yawning="true"] .mouth {
    animation: yawn-mouth 7s ease-in-out infinite;
  }

  @keyframes yawn {
    0%, 70%, 100% { opacity: 0; }
    78%, 90% { opacity: 1; }
  }

  @keyframes yawn-mouth {
    0%, 70%, 100% { opacity: 1; }
    78%, 90% { opacity: 0; }
  }

  [data-pose="stretch"] .rester.stretch {
    animation: stretch 4s ease-in-out infinite;
    transform-origin: 70px 168px;
  }

  @keyframes stretch {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(1.04); }
  }

  @keyframes drift {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(-3px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .walker .body,
    .yawn,
    .mouth,
    .steam,
    .zz,
    .rester.stretch,
    .tower :global(.landed) {
      animation: none !important;
    }
    [data-yawning="true"] .yawn {
      opacity: 1;
    }
    [data-yawning="true"] .mouth {
      opacity: 0;
    }
  }
</style>

<script>
  import { tiredness } from "../lib/worktime";

  const SVG = "http://www.w3.org/2000/svg";
  // where things are on the ground: the pile on the left, the tower on the right
  const GROUND = 170;
  const PILE_X = 62;
  const TOWER_X = 200;
  const BLOCK_H = 9;

  for (const fig of document.querySelectorAll<HTMLElement>(".little-one")) {
    const tower = fig.querySelector<SVGGElement>(".tower");
    const walker = fig.querySelector<SVGGElement>(".walker");
    const carried = fig.querySelector<SVGRectElement>(".carried");
    if (!tower || !walker || !carried) continue;

    const colours: string[] = JSON.parse(fig.dataset.colours ?? "[]");
    const max = Number(fig.dataset.towerMax) || 30;
    const trip = (Number(fig.dataset.carrySeconds) || 4) * 1000;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // the tower: each block a little off-centre and tilted, sized by how
    // tired the little one was when it carried it
    let laid = 0;
    let top = GROUND;
    const lay = (scale: number, animate: boolean) => {
      if (laid >= max) return;
      const w = Math.max(8, Math.round(30 * scale));
      const h = Math.max(4, Math.round(BLOCK_H * Math.max(0.6, scale)));
      const wobble = ((laid * 37) % 7) - 3;
      const x = TOWER_X - w / 2 + wobble * 1.6;
      const y = top - h;
      const r = ((laid * 53) % 9) - 4;
      const rect = document.createElementNS(SVG, "rect");
      rect.setAttribute("class", `tblock c-${colours[laid % colours.length]}${animate ? " landed" : ""}`);
      rect.setAttribute("x", String(x));
      rect.setAttribute("y", String(y));
      rect.setAttribute("width", String(w));
      rect.setAttribute("height", String(h));
      rect.setAttribute("rx", "2");
      rect.setAttribute("transform", `rotate(${r} ${x + w / 2} ${y + h / 2})`);
      tower.append(rect);
      top = y + 0.5;
      laid += 1;
    };
    // today's work so far, laid at once (a foundation block even at the start)
    for (let i = 0; i < Math.max(1, Number(fig.dataset.tower) || 0); i++) lay(1, false);

    if (fig.dataset.state !== "working" || reduced) {
      walker.setAttribute("transform", `translate(${PILE_X + 24} ${GROUND})`);
      continue;
    }

    // how tired it is now, from the same curve the server uses (worktime.ts)
    const sleepyFrom = fig.dataset.sleepyFrom ? Date.parse(fig.dataset.sleepyFrom) : null;
    const carry = Number(fig.dataset.carry) || 0;
    const now = () => {
      const past = sleepyFrom === null ? carry : carry + Math.max(0, (Date.now() - sleepyFrom) / 60_000);
      const t = tiredness(past);
      fig.dataset.yawning = String(t.yawning);
      return t;
    };

    // walk from one spot to another, facing the way it's going
    const walk = (from: number, to: number, ms: number, holding: boolean) =>
      new Promise<void>((done) => {
        const start = performance.now();
        walker.classList.add("walking");
        carried.style.display = holding ? "" : "none";
        const face = to >= from ? 1 : -1;
        const frame = (at: number) => {
          const k = Math.min(1, (at - start) / ms);
          const ease = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
          const x = from + (to - from) * ease;
          walker.setAttribute("transform", `translate(${x} ${GROUND}) scale(${face} 1)`);
          if (k < 1) requestAnimationFrame(frame);
          else {
            walker.classList.remove("walking");
            done();
          }
        };
        requestAnimationFrame(frame);
      });
    const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // one trip: pick up at the pile, carry to the tower, put it on top, go back
    const go = async () => {
      for (;;) {
        const t = now();
        const legs = trip / 2 / t.speed;
        const colour = colours[laid % colours.length];
        carried.setAttribute("class", `carried c-${colour}`);
        carried.setAttribute("width", String(Math.max(6, 18 * t.block)));
        carried.setAttribute("height", String(Math.max(4, 10 * Math.max(0.6, t.block))));
        await pause(300 / t.speed);
        await walk(PILE_X + 12, TOWER_X - 30, legs, true);
        await pause(250 / t.speed);
        if (laid < max) lay(t.block, true);
        await walk(TOWER_X - 30, PILE_X + 12, legs, false);
        if (laid >= max) {
          // today's tower is as tall as it gets: it stays by the pile
          walker.setAttribute("transform", `translate(${PILE_X + 24} ${GROUND})`);
          return;
        }
      }
    };
    void go();
  }
</script>

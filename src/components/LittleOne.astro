---
import { CARRY_SECONDS } from "../lib/limits";
import { gridRects, paletteCss } from "../lib/pixel";
import { KEEPER, WALK } from "../lib/sprites";
import type { WorkView } from "../lib/work";

// The little one: works alongside you on Working on it, only ever for its
// owner. A small pixel world on a page of the notebook: the sky follows the
// clock on your computer (day, dusk, night), and the little one walks across
// the grass, blinking when it stops. Decoration, hidden from screen readers;
// the text beside it says what's going on. With reduced motion it stands
// still. Every frame is a grid of characters (sprites.ts) drawn once here;
// the script only switches which one shows, a frame at a time.
interface Props {
  view: WorkView;
}
const { view } = Astro.props;

// the world, in pixels: wide enough for a pile and a tower, scaled up whole
const W = 112;
const H = 60;
const GROUND = 50;

// the sky gets lighter near the hills: a sparse checker of the paler ink,
// then a full checker, then solid
const dither = (() => {
  let out = "";
  for (let y = 26; y < 34; y++) {
    const step = y < 30 ? 4 : 2;
    const shift = y < 30 ? (y % 2) * 2 : y % 2;
    for (let x = shift; x < W; x += step) out += `<rect class="px-y2" x="${x}" y="${y}" width="1" height="1"/>`;
  }
  return out + `<rect class="px-y2" x="0" y="34" width="${W}" height="${GROUND - 34}"/>`;
})();
// far hills: two soft bumps along the horizon, as one stepped shape so the
// slight tilt of the page leaves no seams between columns
const hills = (() => {
  let d = `M0 ${GROUND}`;
  for (let x = 0; x < W; x++) {
    const top = Math.round(42 - 4 * Math.sin((x + 8) / 14) - 2 * Math.sin(x / 5.5));
    d += ` V${top} H${x + 1}`;
  }
  return `<path class="px-l" d="${d} V${GROUND} Z"/>`;
})();
// grass with darker tufts, and soil with flecks
const ground = (() => {
  let out = `<rect class="px-g" x="0" y="${GROUND}" width="${W}" height="3"/>`;
  out += `<rect class="px-d" x="0" y="${GROUND + 3}" width="${W}" height="${H - GROUND - 3}"/>`;
  for (let x = 1; x < W; x += 3) {
    const k = (x * 7) % 5;
    if (k < 2) out += `<rect class="px-g2" x="${x}" y="${GROUND - 1}" width="1" height="1"/>`;
    if (k === 3) out += `<rect class="px-g2" x="${x}" y="${GROUND + 2}" width="2" height="1"/>`;
    if (k === 1) out += `<rect class="px-d2" x="${(x * 5) % W}" y="${GROUND + 4 + (x % 4)}" width="1" height="1"/>`;
  }
  return out;
})();
const sun = gridRects(
  ["..uuu..", ".uuuuu.", "uuuuuuu", "uuuuuuu", "uuuuuuu", ".uuuuu.", "..uuu.."],
  86,
  7,
);
const stars = [
  [12, 6],
  [27, 12],
  [40, 4],
  [55, 10],
  [70, 5],
  [101, 18],
  [8, 20],
  [62, 19],
]
  .map(([x, y]) => `<rect class="px-w" x="${x}" y="${y}" width="1" height="1"/>`)
  .join("");

const frames = Object.entries(KEEPER.frames)
  .map(([name, rows]) => `<g data-f="${name}">${gridRects(rows)}</g>`)
  .join("");
// which frame shows is one attribute on the actor; CSS hides the rest
const frameCss = Object.keys(KEEPER.frames)
  .map((name) => `.little-one .keeper[data-frame="${name}"] [data-f="${name}"]{display:inline}`)
  .join("\n");
const css = `${paletteCss(".little-one")}\n${frameCss}`;
---

<figure
  class="little-one"
  aria-hidden="true"
  data-state={view.state}
  data-sky="day"
  data-carry-seconds={CARRY_SECONDS}
  data-walk={JSON.stringify(WALK)}
>
  <style set:html={css}></style>
  <div class="page">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      width={W * 3}
      height={H * 3}
      shape-rendering="crispEdges"
      role="presentation"
      focusable="false"
    >
      <rect class="px-y" x="0" y="0" width={W} height={H} />
      <g set:html={dither} />
      <g class="stars" set:html={stars} />
      <g class="sun" set:html={sun} />
      <g set:html={hills} />
      <g set:html={ground} />
      <g
        class="keeper"
        data-frame="stand"
        data-x="24"
        transform={`translate(24 ${GROUND - KEEPER.height + 1})`}
        set:html={frames}
      />
    </svg>
  </div>
</figure>

<style>
  .little-one {
    margin: 1rem 0 0.5rem;
  }

  /* a small picture taped into the notebook: a white border, a slight tilt,
     tape across two corners */
  .page {
    position: relative;
    display: inline-block;
    max-width: 100%;
    padding: 0.5rem;
    background: var(--card);
    box-shadow:
      0 1px 2px rgb(58 53 47 / 0.12),
      0 4px 10px rgb(58 53 47 / 0.08);
    transform: rotate(-0.6deg);
  }

  .page::before,
  .page::after {
    content: "";
    position: absolute;
    width: 3.2rem;
    height: 1.1rem;
    background: rgb(231 214 178 / 0.75);
    box-shadow: 0 1px 1px rgb(58 53 47 / 0.08);
  }

  .page::before {
    top: -0.45rem;
    left: -0.9rem;
    transform: rotate(-32deg);
  }

  .page::after {
    top: -0.45rem;
    right: -0.9rem;
    transform: rotate(30deg);
  }

  svg {
    display: block;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  /* whole multiples of the pixel: 3× on a phone, 5× with room */
  @media (min-width: 46rem) {
    svg {
      width: 560px;
    }
  }

  .keeper :global([data-f]) {
    display: none;
  }

  .stars {
    display: none;
  }

  [data-sky="night"] .stars {
    display: inline;
  }
</style>

<script>
  import { skyFor } from "../lib/pixel";
  import { tiredness } from "../lib/worktime";

  const GROUND = 50;
  const HEIGHT = 24;
  const WIDTH = 16;
  // where it walks between: in front of where the pile and tower will stand
  const LEFT = 18;
  const RIGHT = 78;
  const STEP = 2;

  for (const fig of document.querySelectorAll<HTMLElement>(".little-one")) {
    const keeper = fig.querySelector<SVGGElement>(".keeper");
    if (!keeper) continue;

    // the sky follows the clock where you are
    const setSky = () => (fig.dataset.sky = skyFor(new Date().getHours()));
    setSky();
    setInterval(setSky, 60_000);

    const walkFrames: string[] = JSON.parse(fig.dataset.walk ?? "[]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let x = Number(keeper.dataset.x) || LEFT;

    const place = (frame: string, facing: 1 | -1) => {
      keeper.dataset.frame = frame;
      const left = facing === 1 ? x : x + WIDTH;
      keeper.setAttribute("transform", `translate(${left} ${GROUND - HEIGHT + 1}) scale(${facing} 1)`);
    };
    place("stand", 1);
    if (reduced) continue;

    const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const speed = () => tiredness(0).speed;

    // standing still, it blinks now and then
    const idle = async (ms: number) => {
      const until = performance.now() + ms;
      while (performance.now() < until) {
        place("stand", 1);
        await pause(1400 + Math.random() * 1600);
        place("blink", 1);
        await pause(140);
      }
      place("stand", 1);
    };

    // walking is a frame at a time, a couple of pixels a frame: no gliding
    const walk = async (to: number) => {
      const facing = to >= x ? 1 : -1;
      let i = 0;
      while (x !== to) {
        x += facing * Math.min(STEP, Math.abs(to - x));
        place(walkFrames[i % walkFrames.length], facing);
        i += 1;
        await pause(140 / speed());
      }
      place(walkFrames[1], facing);
    };

    if (fig.dataset.state !== "working") {
      void (async () => {
        for (;;) await idle(10_000);
      })();
      continue;
    }

    void (async () => {
      for (;;) {
        await idle(1800);
        await walk(RIGHT);
        await idle(1200);
        await walk(LEFT);
      }
    })();
  }
</script>

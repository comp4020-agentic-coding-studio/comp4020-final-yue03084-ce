---
import { BRICKS, CARRY_SECONDS, DEFAULT_SCENE_THING, DEFAULT_WEATHER, FLICKER_BELOW } from "../lib/limits";
import { gridRects, paletteCss } from "../lib/pixel";
import type { Scene } from "../lib/scene";
import { blockRows, brickRows, CAN, CARRY, glowRings, KEEPER, LAMP, LAMP_DIM, PLANT, UMBRELLA, WALK, ZED } from "../lib/sprites";
import type { WorkView } from "../lib/work";
import { tiredness, towerPlan } from "../lib/worktime";

// The little one: works alongside you on Working on it, only ever for its
// owner. A small pixel world on a page of the notebook: the sky follows the
// clock on your computer (day, dusk, night). Working, it crouches at the pile,
// picks up a brick, carries it to this session's crooked tower and puts it on
// top, at a pace that reaches two thirds of the way up when the alarm goes
// (towerPlan in worktime.ts); between bricks it pats the last one down.
// Past your alarm it gets sleepy, a little more as time goes on (tiredness()
// in worktime.ts, the metaphor in limits.ts): its eyelids droop, its tuft
// flops, it walks slower, sits down to stare now and then, rubs its eyes,
// yawns, and the bricks get thinner. Sleepy, never sad. On a break it has
// tea, stretches or naps; back at work it stretches first. A lamp stands on
// the grass beside it: its pool of light shrinks and dims as the little one
// gets sleepier (the same tiredness()), flickers now and then, and comes back
// in full on a break. Never a countdown: it never goes out. Its owner can
// choose a little plant instead (its leaves droop as it gets sleepy; on a
// break it's watered and perks up) or nothing but the view, and the
// weather: clear, rain or snow (in the rain it holds an umbrella). The lamp
// is off in daylight. The sky itself only follows the clock. The tower is a
// drawing of this stretch of work, never a number. Decoration, hidden from screen readers;
// the text beside it says what's going on. With reduced motion it holds one
// still frame. Every frame is a grid of characters (sprites.ts) drawn once
// here; the script only switches which one shows, a frame at a time.
interface Props {
  view: WorkView;
  scene?: Scene;
}
const { view, scene } = Astro.props;
const thing = scene?.thing ?? DEFAULT_SCENE_THING;
const weather = scene?.weather ?? DEFAULT_WEATHER;
const t = view.state === "resting" ? tiredness(0) : view.tiredness;
const pose =
  view.state === "resting"
    ? view.restKind === "nap"
      ? "nap"
      : view.restKind === "move" || view.restKind === "walk"
        ? "stretch"
        : "tea"
    : "work";
// the still frame for reduced motion, and the first frame before the script runs
const still =
  pose === "nap" ? "nap1" : pose === "tea" ? "tea1" : pose === "stretch" ? "stretch1" : t.yawning ? "sit~2" : t.sleepy ? "stand~1" : "stand";

// the world, in pixels: wide enough for a pile and a tower, scaled up whole
const W = 112;
const H = 60;
const GROUND = 50;

// the sky gets lighter near the hills: a sparse checker of the paler ink,
// then a full checker, then solid
const dither = (() => {
  let out = "";
  for (let y = 26; y < 34; y++) {
    const step = y < 30 ? 4 : 2;
    const shift = y < 30 ? (y % 2) * 2 : y % 2;
    for (let x = shift; x < W; x += step) out += `<rect class="px-y2" x="${x}" y="${y}" width="1" height="1"/>`;
  }
  return out + `<rect class="px-y2" x="0" y="34" width="${W}" height="${GROUND - 34}"/>`;
})();
// far hills: two soft bumps along the horizon, as one stepped shape so the
// slight tilt of the page leaves no seams between columns
const hills = (() => {
  let d = `M0 ${GROUND}`;
  for (let x = 0; x < W; x++) {
    const top = Math.round(42 - 4 * Math.sin((x + 8) / 14) - 2 * Math.sin(x / 5.5));
    d += ` V${top} H${x + 1}`;
  }
  return `<path class="px-l" d="${d} V${GROUND} Z"/>`;
})();
// grass with darker tufts, and soil with flecks
const ground = (() => {
  let out = `<rect class="px-g" x="0" y="${GROUND}" width="${W}" height="3"/>`;
  out += `<rect class="px-d" x="0" y="${GROUND + 3}" width="${W}" height="${H - GROUND - 3}"/>`;
  for (let x = 1; x < W; x += 3) {
    const k = (x * 7) % 5;
    if (k < 2) out += `<rect class="px-g2" x="${x}" y="${GROUND - 1}" width="1" height="1"/>`;
    if (k === 3) out += `<rect class="px-g2" x="${x}" y="${GROUND + 2}" width="2" height="1"/>`;
    if (k === 1) out += `<rect class="px-d2" x="${(x * 5) % W}" y="${GROUND + 4 + (x % 4)}" width="1" height="1"/>`;
  }
  return out;
})();
const sun = gridRects(
  ["..uuu..", ".uuuuu.", "uuuuuuu", "uuuuuuu", "uuuuuuu", ".uuuuu.", "..uuu.."],
  // left of the tower, so a tall day never covers it
  52,
  6,
);
const stars = [
  [12, 6],
  [27, 12],
  [40, 4],
  [64, 14],
  [70, 5],
  [101, 18],
  [8, 20],
  [62, 19],
]
  .map(([x, y]) => `<rect class="px-w" x="${x}" y="${y}" width="1" height="1"/>`)
  .join("");

// the pile it fetches from, and the bricks it can lay: one drawing per
// colour and size, so the script picks one rather than drawing pixels
const INKS = ["1", "2", "3", "4"];
const plan = towerPlan(view.towerMinutes);
const pile = [
  [4, GROUND - 4, 10, 4, "3"],
  [14, GROUND - 4, 9, 4, "1"],
  [8, GROUND - 8, 9, 4, "2"],
  [6, GROUND - 12, 7, 4, "4"],
]
  .map(([x, y, w, h, ink]) => gridRects(blockRows(w as number, h as number, ink as string), x as number, y as number))
  .join("");
// every brick a tower can have, full height and the thinner sleepy one
const brickSizes = [
  ...new Set(BRICKS.flatMap((b) => [`${b.width}-${b.height}`, `${b.width}-${Math.max(1, Math.round(b.height / 2))}`])),
];
const blocks = INKS.flatMap((ink) =>
  brickSizes.map((wh) => {
    const [w, h] = wh.split("-").map(Number);
    return `<g data-k="${ink}-${wh}">${gridRects(brickRows(w, h, ink))}</g>`;
  }),
).join("");
const zed = gridRects(ZED);

// the lamp past the tower, out of the little one's way, its light falling
// on the day's work: RINGS rings around the bulb, the outer ones sparser;
// glow decides how many show
const LAMP_X = 94;
const LAMP_Y = GROUND - LAMP.length + 1;
const BULB = { x: LAMP_X + 3, y: LAMP_Y + 4 };
const RINGS = 6;
const lamp = gridRects(LAMP, LAMP_X, LAMP_Y);
const lampDim = gridRects(LAMP_DIM, LAMP_X, LAMP_Y);
const rings = glowRings(RINGS, 3).map(
  (pts, k) =>
    `<g data-ring="${k}" style="opacity:${(0.55 * (1 - k / RINGS) + 0.12).toFixed(2)}">${pts
      .map((p) => {
        const [x, y] = p.split(",").map(Number);
        return `<rect class="${k < 2 ? "px-i" : "px-j"}" x="${BULB.x + x}" y="${BULB.y + y}" width="1" height="1"/>`;
      })
      .join("")}</g>`,
);
// how many rings show for a glow, and whether the lamp flickers: the same
// sum in the page and the script
const ringsFor = (glow: number) => Math.max(2, Math.round(RINGS * glow));
const lit = ringsFor(t.glow);

// the plant stands where the lamp would, in one of three moods; on a break
// it's just been watered: the can is set down beside the pot
const PLANT_X = 94;
const PLANT_Y = GROUND - 13;
const moodFor = (tt: typeof t) => (!tt.sleepy ? "up" : tt.yawning ? "sleepy" : "droop");
const plant = Object.entries(PLANT)
  .map(([mood, rows]) => `<g data-mood="${mood}">${gridRects(rows, PLANT_X, PLANT_Y)}</g>`)
  .join("");
const can = gridRects(CAN, PLANT_X - 10, GROUND - CAN.length + 1);

// weather: rain is short upright streaks, snow single flakes, each in its own
// column at its own height so they don't fall in rows. The script moves
// them a pixel at a time; with reduced motion they hang where they start.
// a fixed scatter (the golden-ratio sequence), so the same page always
// starts with the same sky and no two drops share a row or column
const scatter = (i: number, span: number, salt: number) => Math.floor((((i + 1) * (0.6180339887 + salt)) % 1) * span);
const fall = (kind: "rain" | "snow") =>
  Array.from({ length: kind === "rain" ? 26 : 20 }, (_, i) => {
    const x = scatter(i, W, 0);
    const y = scatter(i, GROUND - 4, 0.1415926535);
    const h = kind === "rain" ? 3 : 1;
    return `<rect class="${kind === "rain" ? "px-z" : "px-z2"}" x="${x}" y="${y}" width="1" height="${h}"/>`;
  }).join("");
const rain = fall("rain");
const umbrella = gridRects(UMBRELLA);
const snow = fall("snow");

const frames = Object.entries(KEEPER.frames)
  .map(([name, rows]) => `<g data-f="${name}">${gridRects(rows)}</g>`)
  .join("");
// which frame shows is one attribute on the actor; CSS hides the rest
const frameCss = Object.keys(KEEPER.frames)
  .map((name) => `.little-one .keeper[data-frame="${name}"] [data-f="${name}"]{display:inline}`)
  .join("\n");
// rings beyond how many are lit stay hidden: with L lit, rings L and up
const ringCss = Array.from({ length: RINGS }, (_, lit) =>
  Array.from({ length: RINGS - lit }, (_, j) => `.little-one[data-lit="${lit}"] [data-ring="${lit + j}"]`),
)
  .flat()
  .join(",");
const css = `${paletteCss(".little-one")}\n${frameCss}\n${ringCss}{display:none}`;
---

<figure
  class="little-one"
  aria-hidden="true"
  data-state={view.state}
  data-pose={pose}
  data-sky="day"
  data-sleepy-from={view.sleepyFrom ?? ""}
  data-carry={view.carry}
  data-tower-minutes={plan.minutes}
  data-worked={view.worked}
  data-carry-seconds={CARRY_SECONDS}
  data-walk={JSON.stringify(WALK)}
  data-carry-frames={JSON.stringify(CARRY)}
  data-inks={JSON.stringify(INKS)}
  data-rings={RINGS}
  data-lit={lit}
  data-flicker-below={FLICKER_BELOW}
  data-thing={thing}
  data-weather={weather}
  data-mood={view.state === "resting" ? "up" : moodFor(t)}
>
  <style set:html={css}></style>
  <div class="page">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      width={W * 3}
      height={H * 3}
      shape-rendering="crispEdges"
      role="presentation"
      focusable="false"
    >
      <rect class="px-y" x="0" y="0" width={W} height={H} />
      <g set:html={dither} />
      <g class="stars" set:html={stars} />
      <g class="sun" set:html={sun} />
      <g set:html={hills} />
      <g set:html={ground} />
      <g class="for-lamp">
        <g class="glow" set:html={rings.join("")} />
        <g class="lamp" set:html={lamp} />
        <g class="lamp-dim" set:html={lampDim} />
      </g>
      <g class="for-plant">
        <g class="plant" set:html={plant} />
        <g class="can" set:html={can} />
      </g>
      <g class="pile" set:html={pile} />
      <!-- this session's tower; the script lays its bricks, starting from the work so far -->
      <g class="tower"></g>
      <!-- the drawings the script copies a block from -->
      <defs set:html={blocks} />
      <g
        class="keeper"
        data-frame={still}
        transform={`translate(24 ${GROUND - KEEPER.height + 1})`}
        set:html={frames}
      />
      <g class="held"></g>
      <!-- in the rain, held over its head wherever it goes -->
      <g class="umbrella" set:html={umbrella} />
      <g class="zed" set:html={zed} />
      <g class="weather rain" set:html={rain} />
      <g class="weather snow" set:html={snow} />
    </svg>
  </div>
</figure>

<style>
  .little-one {
    margin: 1rem 0 0.5rem;
  }

  /* a small picture taped into the notebook: a white border, a slight tilt,
     tape across two corners */
  .page {
    position: relative;
    display: inline-block;
    max-width: 100%;
    padding: 0.5rem;
    background: var(--card);
    box-shadow:
      0 1px 2px rgb(58 53 47 / 0.12),
      0 4px 10px rgb(58 53 47 / 0.08);
    transform: rotate(-0.6deg);
  }

  .page::before,
  .page::after {
    content: "";
    position: absolute;
    width: 3.8rem;
    height: 1.3rem;
    /* wine-red washi tape with pale polka dots */
    background-color: rgb(122 38 52 / 0.88);
    background-image:
      radial-gradient(circle, rgb(250 236 228 / 0.9) 0 1.8px, transparent 2.3px),
      radial-gradient(circle, rgb(250 236 228 / 0.9) 0 1.8px, transparent 2.3px);
    background-size: 12px 12px;
    background-position:
      0 0,
      6px 6px;
    box-shadow: 0 1px 1px rgb(58 53 47 / 0.08);
  }

  .page::before {
    top: -0.45rem;
    left: -0.9rem;
    transform: rotate(-32deg);
  }

  .page::after {
    top: -0.45rem;
    right: -0.9rem;
    transform: rotate(30deg);
  }

  svg {
    display: block;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  /* whole multiples of the pixel: 3× on a phone, 5× with room */
  @media (min-width: 46rem) {
    svg {
      width: 560px;
    }
  }

  .keeper :global([data-f]) {
    display: none;
  }

  .stars {
    display: none;
  }

  [data-sky="night"] .stars {
    display: inline;
  }

  /* the light is brighter at night, softer in the day; a flicker dims it
     for a moment and swaps the bulb out */
  .glow {
    opacity: 0.6;
    transition: opacity 0.6s steps(3);
  }

  /* in daylight the lamp is off: no light, the bulb drawn unlit */
  [data-sky="day"] .glow,
  [data-sky="day"] .lamp {
    display: none;
  }

  [data-sky="day"] .lamp-dim {
    display: inline;
  }

  [data-sky="dusk"] .glow {
    opacity: 0.75;
  }

  [data-sky="night"] .glow {
    opacity: 0.9;
  }

  .lamp-dim {
    display: none;
  }

  [data-flicker="on"] .glow {
    opacity: 0.25;
    transition: none;
  }

  [data-flicker="on"] .lamp {
    display: none;
  }

  [data-flicker="on"] .lamp-dim {
    display: inline;
  }

  .umbrella {
    display: none;
  }

  [data-weather="rain"] .umbrella {
    display: inline;
  }

  /* only the thing its owner chose is in the picture */
  .for-lamp,
  .for-plant {
    display: none;
  }

  [data-thing="lamp"] .for-lamp,
  [data-thing="plant"] .for-plant {
    display: inline;
  }

  /* the plant shows one mood at a time */
  .plant :global([data-mood]) {
    display: none;
  }

  [data-mood="up"] .plant :global([data-mood="up"]),
  [data-mood="droop"] .plant :global([data-mood="droop"]),
  [data-mood="sleepy"] .plant :global([data-mood="sleepy"]) {
    display: inline;
  }

  /* on a break the plant has just been watered: the can beside it */
  .can {
    display: none;
  }

  [data-state="resting"] .can {
    display: inline;
  }

  /* rain and snow fall a pixel at a time; rain fast, snow slow and drifting */
  .weather {
    display: none;
  }

  [data-weather="rain"] .rain,
  [data-weather="snow"] .snow {
    display: inline;
  }

  /* a z drifts up off a nap, a pixel at a time */
  .zed {
    display: none;
  }

  [data-pose="nap"] .zed {
    display: inline;
    animation: zed 3s steps(6) infinite;
  }

  @keyframes zed {
    0% { transform: translate(40px, 30px); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translate(44px, 22px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-pose="nap"] .zed {
      animation: none;
      transform: translate(42px, 26px);
    }
  }
</style>

<script>
  import { skyFor } from "../lib/pixel";
  import { bricksLaid, tiredness, towerPlan } from "../lib/worktime";

  const SVG = "http://www.w3.org/2000/svg";
  const GROUND = 50;
  const HEIGHT = 24;
  // the frame is 20 wide: the little one is 16, with room for arms out
  const WIDTH = 20;
  // where it stands: beside the pile on the left, beside the tower on the right
  const PILE = 20;
  const TOWER = 84;
  const BESIDE_TOWER = TOWER - WIDTH;
  // tapping, it stands back so the mallet's head (its frame's last three
  // columns) knocks against the tower's left edge rather than over the bricks
  const TAPPING_AT = (towerLeft: number) => towerLeft - WIDTH - 1;
  const STEP = 2;
  // a block every ~10 frames; how long one frame shows when it's fresh
  const FRAME_MS = 140;

  for (const fig of document.querySelectorAll<HTMLElement>(".little-one")) {
    const keeper = fig.querySelector<SVGGElement>(".keeper");
    const tower = fig.querySelector<SVGGElement>(".tower");
    const held = fig.querySelector<SVGGElement>(".held");
    if (!keeper || !tower || !held) continue;

    // the sky follows the clock where you are
    const setSky = () => (fig.dataset.sky = skyFor(new Date().getHours()));
    setSky();
    setInterval(setSky, 60_000);

    const walkFrames: string[] = JSON.parse(fig.dataset.walk ?? "[]");
    const carryFrames: string[] = JSON.parse(fig.dataset.carryFrames ?? "[]");
    const inks: string[] = JSON.parse(fig.dataset.inks ?? "[]");
    const plan = towerPlan(Number(fig.dataset.towerMinutes) || 60);
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // a copy of one of the brick drawings, placed at (x, y)
    const block = (ink: string, w: number, h: number, x: number, y: number) => {
      const src = fig.querySelector(`[data-k="${ink}-${w}-${h}"]`);
      const g = document.createElementNS(SVG, "g");
      g.innerHTML = src?.innerHTML ?? "";
      g.setAttribute("transform", `translate(${x} ${y})`);
      return g;
    };

    // the tower: bricks side by side, a layer at a time, each layer a pixel
    // or so off the one below; past the alarm they come thinner
    let laid = 0;
    let top = GROUND;
    const full = () => laid >= plan.capacity;
    const heightAt = (i: number) => (i < plan.before ? plan.height : plan.sleepyHeight);
    const inkAt = (i: number) => inks[(i + Math.floor(i / plan.perLayer)) % inks.length];
    const lay = () => {
      if (full()) return;
      const layer = Math.floor(laid / plan.perLayer);
      const j = laid % plan.perLayer;
      const h = heightAt(laid);
      if (j === 0) top -= h;
      const wobble = ((layer * 37) % 3) - 1;
      const x = TOWER - Math.floor((plan.perLayer * plan.width) / 2) + wobble + j * plan.width;
      tower.append(block(inkAt(laid), plan.width, h, x, top));
      laid += 1;
    };
    // how many bricks the work so far has earned: from the server's count at
    // load, then the clock while the page stays open and working
    const loaded = Date.now();
    const workedAt = Number(fig.dataset.worked) || 0;
    const working = fig.dataset.state === "working";
    const earned = () => bricksLaid(plan, workedAt + (working ? (Date.now() - loaded) / 60_000 : 0));
    for (let i = earned(); i > 0; i--) lay();

    let x = PILE;
    let facing: 1 | -1 = 1;
    // the umbrella rides just above the top of whatever frame is showing
    const umbrella = fig.querySelector<SVGGElement>(".umbrella");
    const tops: Record<string, number> = {};
    const topOf = (frame: string) => {
      if (!(frame in tops)) {
        const g = keeper.querySelector<SVGGElement>(`[data-f="${frame}"]`);
        const ys = [...(g?.querySelectorAll("rect") ?? [])].map((r) => Number(r.getAttribute("y")));
        tops[frame] = ys.length ? Math.min(...ys) : 0;
      }
      return tops[frame];
    };
    const place = (frame: string, dir: 1 | -1 = facing) => {
      facing = dir;
      keeper.dataset.frame = frame;
      const left = dir === 1 ? x : x + WIDTH;
      keeper.setAttribute("transform", `translate(${left} ${GROUND - HEIGHT + 1}) scale(${dir} 1)`);
      // centred on the little one (its handle over the middle of the frame)
      umbrella?.setAttribute("transform", `translate(${x - 3} ${GROUND - HEIGHT + 1 + topOf(frame) - 10})`);
    };
    // the brick it carries rides in its hands, just in front of it
    const hold = (ink: string | null) => {
      held.replaceChildren();
      if (!ink) return;
      const h = heightAt(laid);
      const bx = facing === 1 ? x + 14 : x + 6 - plan.width;
      held.append(block(ink, plan.width, h, bx, GROUND - 9 - h));
    };
    const still = keeper.dataset.frame ?? "stand";
    place(still, 1);
    if (fig.dataset.state !== "working") x = 28;
    if (reduced) {
      place(still, 1);
      continue;
    }

    const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // rain falls two pixels a frame, slanting a little; snow one pixel every
    // few frames, drifting side to side. Back to the top past the grass.
    const weather = fig.dataset.weather;
    const flakes = [...fig.querySelectorAll<SVGRectElement>(`.weather.${weather} rect`)];
    if (flakes.length) {
      const rain = weather === "rain";
      let tick = 0;
      setInterval(
        () => {
          tick += 1;
          flakes.forEach((f, i) => {
            let fx = Number(f.getAttribute("x"));
            let fy = Number(f.getAttribute("y"));
            if (rain) {
              fy += 2;
              if (tick % 3 === 0) fx -= 1;
            } else {
              if ((tick + i) % 3 !== 0) return;
              fy += 1;
              if ((tick + i) % 12 === 0) fx += ((i + (tick >> 4)) % 2) * 2 - 1;
            }
            // past the grass, start again somewhere new along the top
            if (fy > GROUND - 2) {
              fy = -3 - Math.floor(Math.random() * 12);
              fx = Math.floor(Math.random() * 112);
            }
            f.setAttribute("x", String(((fx % 112) + 112) % 112));
            f.setAttribute("y", String(fy));
          });
        },
        rain ? 70 : 110,
      );
    }

    // how tired it is now, from the same curve the server uses (worktime.ts)
    const sleepyFrom = fig.dataset.sleepyFrom ? Date.parse(fig.dataset.sleepyFrom) : null;
    const carry = Number(fig.dataset.carry) || 0;
    const now = () => tiredness(sleepyFrom === null ? carry : carry + Math.max(0, (Date.now() - sleepyFrom) / 60_000));
    // three looks: fresh, drooping, nearly asleep; the frame names carry it
    const tier = (t: ReturnType<typeof now>) => (!t.sleepy ? "" : t.yawning ? "~2" : "~1");
    const ms = (t: ReturnType<typeof now>) => FRAME_MS / t.speed;

    // the lamp keeps up with it: fewer rings of light as the glow falls, and
    // below FLICKER_BELOW a flicker now and then (two quick dips). On a break
    // the server already sent full glow, so it's lit and steady.
    const rings = Number(fig.dataset.rings) || 6;
    const flickerBelow = Number(fig.dataset.flickerBelow) || 0.75;
    if (fig.dataset.state === "working") {
      const light = () => {
        const t = now();
        fig.dataset.lit = String(Math.max(2, Math.round(rings * t.glow)));
        // the plant keeps up too: perked up, drooping, sleepy
        fig.dataset.mood = !t.sleepy ? "up" : t.yawning ? "sleepy" : "droop";
        return t.glow;
      };
      light();
      setInterval(light, 20_000);
      void (async () => {
        for (;;) {
          await pause(6000 + Math.random() * 9000);
          if (light() >= flickerBelow || fig.dataset.thing !== "lamp" || fig.dataset.sky === "day") continue;
          for (const ms of [90, 70, 160, 60]) {
            fig.dataset.flicker = fig.dataset.flicker === "on" ? "" : "on";
            await pause(ms);
          }
          fig.dataset.flicker = "";
        }
      })();
    }

    // standing still, it blinks now and then (only when it's wide awake)
    const idle = async (time: number) => {
      const t = now();
      const until = performance.now() + time;
      while (performance.now() < until) {
        place(`stand${tier(t)}`);
        await pause(1400 + Math.random() * 1600);
        if (!t.sleepy) {
          place("blink");
          await pause(140);
        }
      }
    };

    // walking is a frame at a time, a couple of pixels a frame: no gliding
    const walk = async (to: number, holding: string | null, brisk = false) => {
      const t = now();
      if (brisk) t.speed = Math.max(t.speed, 1.4);
      const dir = to >= x ? 1 : -1;
      const frames = holding ? carryFrames : walkFrames;
      // tired, it shuffles: smaller steps
      const step = t.yawning ? 1 : STEP;
      let i = 0;
      while (x !== to) {
        x += dir * Math.min(step, Math.abs(to - x));
        place(`${frames[i % frames.length]}${tier(t)}`, dir);
        hold(holding);
        i += 1;
        await pause(ms(t));
      }
      place(`${frames[1]}${tier(t)}`, dir);
    };

    // sleepy, now and then: a rub of the eyes, a yawn, or sitting down to stare
    const drowse = async () => {
      const t = now();
      if (!t.sleepy) return;
      const r = Math.random();
      if (r < 0.3) {
        place("rub", 1);
        await pause(900);
      } else if (t.yawning && r < 0.6) {
        place("yawn", 1);
        await pause(1300);
      } else if (t.yawning && r < 0.85) {
        place("sit~2", 1);
        await pause(2500 + Math.random() * 2000);
      }
    };

    // between bricks, beside the tower: a few knocks with its mallet, then a
    // step back to look the tower over; now and then a stretch, and sleepy,
    // it drowses as well
    const tend = async () => {
      const t = now();
      await walk(TAPPING_AT(TOWER - Math.floor((plan.perLayer * plan.width) / 2)), null);
      for (let i = 0; i < 3; i++) {
        place(`tap1${tier(t)}`, 1);
        await pause(ms(t) * 3);
        place(`tap2${tier(t)}`, 1);
        await pause(ms(t) * 2);
      }
      place(`stand${tier(t)}`, 1);
      await pause(ms(t) * 2);
      await walk(BESIDE_TOWER - 8, null);
      place(`walk2${tier(t)}`, 1);
      await pause(1600 + Math.random() * 1200);
      if (!t.sleepy && Math.random() < 0.2) {
        place("stretch1", 1);
        await pause(800);
      }
      await drowse();
      await walk(BESIDE_TOWER, null);
      await idle(800 + Math.random() * 1200);
    };

    // resting: tea (sips now and then), a stretch, or a nap that breathes
    if (fig.dataset.state !== "working") {
      const pose = fig.dataset.pose;
      void (async () => {
        for (;;) {
          if (pose === "nap") {
            place("nap1", 1);
            await pause(1600);
            place("nap2", 1);
            await pause(1600);
          } else if (pose === "stretch") {
            place("stand", 1);
            await pause(1800);
            place("stretch1", 1);
            await pause(900);
            place("stretch2", 1);
            await pause(1200);
            place("stretch1", 1);
            await pause(600);
          } else {
            for (let i = 0; i < 6; i++) {
              place(i % 2 ? "tea2" : "tea1", 1);
              await pause(700);
            }
            place("sip", 1);
            await pause(1200);
          }
        }
      })();
      continue;
    }

    void (async () => {
      // back at work (or just starting): a stretch first, tuft up
      if (!now().sleepy) {
        place("stretch1", 1);
        await pause(700);
        place("stretch2", 1);
        await pause(900);
        place("stand", 1);
        await pause(500);
      }
      // the first trip after a rest is brisk
      let brisk = true;
      for (;;) {
        // a tab left in the background catches up at once, bar the one brick
        // it's about to fetch
        while (laid < earned() - 1 && !full()) lay();
        if (full()) {
          // the tower is as tall as it gets: it stays beside it
          x = BESIDE_TOWER;
          await idle(1e9);
          return;
        }
        // fetch the next brick and lay it, then tend the tower until the
        // work has earned another: never strolling about with nothing to do
        const t = now();
        const ink = inkAt(laid);
        await walk(PILE, null, brisk);
        place(`crouch${tier(t)}`, 1);
        await pause(ms(t) * 4);
        hold(ink);
        await walk(BESIDE_TOWER, ink, brisk);
        place(`crouch${tier(t)}`, 1);
        hold(null);
        await pause(ms(t) * 3);
        lay();
        brisk = false;
        while (laid >= earned() + 1 && !full()) await tend();
      }
    })();
  }
</script>

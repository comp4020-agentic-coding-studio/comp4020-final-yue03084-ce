---
import Meadow from "./Meadow.astro";
import { currentBreak, restingNow } from "../lib/db";
import { BREAK_KINDS } from "../lib/limits";
import { signedInPerson } from "../lib/person";

// "Take a break": one line, "Take a break: walk · tea · …" (each a submit
// button in a plain form) or, while you're on one, a button to come back.
// Under it, only while someone is resting, how many (a number, never who)
// and the meadow. Nobody resting is an empty line, not a sentence. The
// feed's script keeps the count live.
// anyone sees the count; starting a break needs an account
const person = signedInPerson(Astro.cookies);
const mine = person ? currentBreak(person.id) : undefined;
const count = restingNow();
const resting = (n: number) => (n === 0 ? "" : n === 1 ? "1 person is on a break right now." : `${n} people are on a break right now.`);
---

<section class="breakbox" aria-labelledby="break-h">
  <div class="break-line">
    <h2 id="break-h">Take a break:</h2>
    {
      !person ? (
        <p class="join-hint">
          <a href="/account/">Sign in</a> to take one.
        </p>
      ) : mine ? (
        <form method="post" action="/break/" class="break-back">
          <input type="hidden" name="end" value="1" />
          <input type="hidden" name="back" value={Astro.url.pathname} />
          <span>You're on a break ({BREAK_KINDS[mine.kind as keyof typeof BREAK_KINDS]?.label.toLowerCase() ?? "resting"}).</span>
          <button type="submit">I'm back</button>
        </form>
      ) : (
        <form method="post" action="/break/" class="break-go">
          <input type="hidden" name="back" value={Astro.url.pathname} />
          {Object.entries(BREAK_KINDS).map(([key, k]) => (
            <button type="submit" name="kind" value={key} aria-label={k.label}>
              {k.short}
            </button>
          ))}
        </form>
      )
    }
  </div>
  <p class="resting" id="resting" aria-live="polite" data-template-one="1 person is on a break right now." data-template-none="">
    {resting(count)}
  </p>
  <Meadow />
</section>

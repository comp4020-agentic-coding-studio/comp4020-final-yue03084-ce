---
import { gridRects, HAIRS, paletteCss } from "../lib/pixel";
import { blockRows, CARRY, KEEPER, WALK } from "../lib/sprites";

// The home page's scene: two little ones take turns carrying uneven blocks
// from their piles to a crooked tower. When it's tall enough they put the
// last one down, sit either side of it with a cup of tea for a while, and
// then start again. Drawn in the site's pixel art (the little one's frames
// in sprites.ts, the palette in pixel.ts), on the page itself with just a
// line of grass, so it reads as the header, not a second framed picture.
// Decoration only, so it's hidden from screen readers; with reduced motion
// (or before the script runs) it shows the resting moment and stays there.
const W = 116;
const GROUND = 26; // the row the little ones' feet stand on
const H = GROUND + 3;
const WIDTH = KEEPER.width;
const HEIGHT = KEEPER.height;

// the tower, bottom up: width, height, a nudge sideways (so it leans and
// wobbles, never quite straight) and the block's colour (inks 1 to 4)
const tower = [
  { w: 12, h: 4, dx: 0, ink: "4" },
  { w: 10, h: 4, dx: 2, ink: "1" },
  { w: 11, h: 3, dx: 0, ink: "3" },
  { w: 8, h: 4, dx: 3, ink: "2" },
  { w: 9, h: 3, dx: 1, ink: "4" },
  { w: 7, h: 3, dx: 3, ink: "1" },
];
const CENTRE = 58;
let top = GROUND + 1;
const blocks = tower.map((b, i) => {
  top -= b.h;
  return { ...b, i, x: CENTRE - Math.floor(b.w / 2) + b.dx, y: top, rows: gridRects(blockRows(b.w, b.h, b.ink)) };
});

// where each little one stands and sits (the left edge of its 20-wide
// frame). The one on the left carries the even blocks, the one on the right
// the odd ones, from a pile at its own edge of the picture.
const spots = {
  left: { pile: 12, tower: 32, tea: 30, pileX: 1 },
  right: { pile: 84, tower: 64, tea: 66, pileX: 103 },
};

const POSES = ["stand", "blink", "crouch", "stretch1", "tea1", "tea2", "sip", ...WALK, ...CARRY];
const frames = POSES.map((name) => `<g data-f="${name}">${gridRects(KEEPER.frames[name])}</g>`).join("");
const frameCss = POSES.map((n) => `.scene .one[data-frame="${n}"] [data-f="${n}"]{display:inline}`).join("\n");
// two hair colours, so the two can be told apart
const hairCss = [0, 2]
  .map((h, i) => `.scene .one[data-hair="${i}"]{--px-h:${HAIRS[h].h};--px-o:${HAIRS[h].o};--px-h2:${HAIRS[h].H}}`)
  .join("\n");
const css = `${paletteCss(".scene", { weather: false })}\n.scene [data-f]{display:none}\n${frameCss}\n${hairCss}`;

// the grass: one line of it, with a tuft here and there, and a few specks of soil
const ground = (() => {
  let out = `<rect class="px-g" x="0" y="${GROUND + 1}" width="${W}" height="1"/>`;
  for (let x = 3; x < W; x += 5) if ((x * 7) % 9 < 3) out += `<rect class="px-g2" x="${x}" y="${GROUND}" width="1" height="1"/>`;
  for (let x = 1; x < W; x += 6) out += `<rect class="px-d" x="${x + ((x * 5) % 3)}" y="${GROUND + 2 + (x % 2)}" width="1" height="1"/>`;
  return out;
})();

// before the script, and with reduced motion: the tower built, both at tea
const at = (x: number, dir: 1 | -1) => `translate(${dir === 1 ? x : x + WIDTH} ${GROUND - HEIGHT + 1}) scale(${dir} 1)`;
---

<figure
  class="scene"
  aria-hidden="true"
  data-ground={GROUND}
  data-spots={JSON.stringify(spots)}
  data-blocks={JSON.stringify(blocks.map(({ w, h, x, y }) => ({ w, h, x, y })))}
>
  <style set:html={css}></style>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width={W * 3}
    height={H * 3}
    shape-rendering="crispEdges"
    role="presentation"
    focusable="false"
  >
    <g set:html={ground} />
    {blocks.map((b) => <g class="blk" data-b={b.i} transform={`translate(${b.x} ${b.y})`} set:html={b.rows} />)}
    <g class="one" data-who="left" data-hair="0" data-frame="tea1" transform={at(spots.left.tea, 1)} set:html={frames} />
    <g class="one" data-who="right" data-hair="1" data-frame="tea2" transform={at(spots.right.tea, -1)} set:html={frames} />
  </svg>
</figure>

<style>
  .scene {
    margin: 0 0 var(--s3);
  }

  /* whole multiples of the pixel: 2× on a phone, 3× with room, about half
     the height it was, so it heads the page without filling it */
  svg {
    display: block;
    width: 232px;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    image-rendering: pixelated;
  }

  @media (min-width: 46rem) {
    svg {
      width: 348px;
    }
  }

  .blk {
    transition: opacity 600ms ease-out;
  }

  .blk.gone {
    opacity: 0;
  }
</style>

<script>
  import { CARRY, WALK } from "../lib/sprites";

  // The loop, a frame at a time: each little one crouches at its pile, picks
  // up a block, carries it to the tower (waiting its turn if the other is
  // still putting one down), puts it on top and walks back. When the last
  // block is on, both sit down for tea; then the tower is put away and they
  // start again.
  const WIDTH = 20;
  const HEIGHT = 24;
  const STEP = 110; // ms per pixel walked
  const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));

  interface Block {
    w: number;
    h: number;
    x: number;
    y: number;
  }
  interface Spot {
    pile: number;
    tower: number;
    tea: number;
    pileX: number;
  }

  for (const fig of document.querySelectorAll<HTMLElement>(".scene")) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    const GROUND = Number(fig.dataset.ground);
    const spots: Record<"left" | "right", Spot> = JSON.parse(fig.dataset.spots ?? "{}");
    const blocks: Block[] = JSON.parse(fig.dataset.blocks ?? "[]");
    const els = [...fig.querySelectorAll<SVGGElement>(".blk")];
    const ones = {
      left: fig.querySelector<SVGGElement>('.one[data-who="left"]'),
      right: fig.querySelector<SVGGElement>('.one[data-who="right"]'),
    };
    if (!ones.left || !ones.right || els.length !== blocks.length) continue;

    const move = (el: SVGGElement, x: number, y: number) => el.setAttribute("transform", `translate(${x} ${y})`);
    // each pile: its blocks stacked where they wait, the next one to carry on top
    const pileOf = (side: "left" | "right") => blocks.map((b, i) => ({ b, i })).filter(({ i }) => (i % 2 === 0) === (side === "left"));
    const toPiles = () => {
      for (const side of ["left", "right"] as const) {
        let y = GROUND + 1;
        for (const { b, i } of pileOf(side).reverse()) {
          y -= b.h;
          const x = side === "left" ? spots.left.pileX : spots.right.pileX + 12 - b.w;
          move(els[i], x, y);
        }
      }
    };

    let laid = 0;
    const runner = (side: "left" | "right") => {
      const g = ones[side] as SVGGElement;
      const spot = spots[side];
      // walking toward the tower faces it; at the pile it faces outwards
      const inward: 1 | -1 = side === "left" ? 1 : -1;
      let x = spot.pile;
      let dir: 1 | -1 = -inward as 1 | -1;
      const place = (frame: string) => {
        g.dataset.frame = frame;
        g.setAttribute("transform", `translate(${dir === 1 ? x : x + WIDTH} ${GROUND - HEIGHT + 1}) scale(${dir} 1)`);
      };
      // the block it carries rides in its hands, just in front of it
      const hold = (i: number) => {
        const b = blocks[i];
        move(els[i], dir === 1 ? x + 14 : x + 6 - b.w, GROUND - 9 - b.h);
      };
      const walkTo = async (to: number, frames: readonly string[], carrying?: number) => {
        dir = to > x ? 1 : -1;
        let n = 0;
        while (x !== to) {
          x += Math.sign(to - x);
          place(frames[n++ % frames.length]);
          if (carrying !== undefined) hold(carrying);
          await pause(STEP);
        }
      };
      return {
        async work() {
          for (const { i } of pileOf(side)) {
            // at the pile: bend down, pick it up, turn round
            dir = -inward as 1 | -1;
            place("crouch");
            await pause(500);
            hold(i);
            await pause(300);
            dir = inward;
            place("carry2");
            hold(i);
            await pause(250);
            await walkTo(spot.tower, CARRY, i);
            // wait for the other one to put theirs down first
            place("carry2");
            while (laid !== i) await pause(100);
            // a high block goes up with both arms
            if (blocks[i].y < GROUND - 14) {
              place("stretch1");
              await pause(350);
            }
            move(els[i], blocks[i].x, blocks[i].y);
            laid += 1;
            place("stand");
            await pause(450);
            await walkTo(spot.pile, WALK);
          }
          // done: over to the tower to sit down
          await walkTo(spot.tea, WALK);
          dir = inward;
          place("stand");
        },
        async tea(rounds: number) {
          dir = inward;
          for (let r = 0; r < rounds; r++) {
            place(r % 2 ? "tea2" : "tea1");
            await pause(700);
            if (r % 4 === 3) {
              place("sip");
              await pause(1100);
            }
          }
        },
        async goBack() {
          await walkTo(spot.pile, WALK);
          dir = -inward as 1 | -1;
          place("stand");
          await pause(400);
          place("blink");
          await pause(160);
          place("stand");
        },
      };
    };

    const left = runner("left");
    const right = runner("right");
    void (async () => {
      // the page opens on the resting moment, then the first round begins
      await pause(2500);
      while (true) {
        // the tower is put away, the blocks back on their piles
        for (const el of els) el.classList.add("gone");
        await pause(600);
        toPiles();
        laid = 0;
        await Promise.all([left.goBack(), right.goBack()]);
        for (const el of els) el.classList.remove("gone");
        await pause(700);
        // the one on the right starts a beat later, so they take turns
        await Promise.all([left.work(), pause(1400).then(() => right.work())]);
        // tall enough: they look at it, then tea
        await pause(900);
        await Promise.all([left.tea(12), pause(350).then(() => right.tea(12))]);
      }
    })();
  }
</script>

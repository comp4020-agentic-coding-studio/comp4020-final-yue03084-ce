---
import { SCENE_THINGS, type SceneThing, WEATHERS } from "../lib/limits";
import type { Scene } from "../lib/scene";

// Choose what's in the little one's picture and the weather, kept with your
// account as soon as it's chosen. Two groups of radio buttons in one plain form: labelled, and the
// arrow keys move within a group. The owner's alone. Only the things they can
// choose are offered: the sunflower once it's come from their Collection.
interface Props {
  scene: Scene;
  things: SceneThing[];
}
const { scene, things } = Astro.props;
---

<form method="post" action="/scene/" class="scene-picker">
  <fieldset class="choices">
    <legend>Scene</legend>
    {
      things.map((key) => (
        <label class="inline">
          <input type="radio" name="thing" value={key} checked={scene.thing === key} /> {SCENE_THINGS[key]}
        </label>
      ))
    }
  </fieldset>
  <fieldset class="choices">
    <legend>Weather</legend>
    {
      Object.entries(WEATHERS).map(([key, label]) => (
        <label class="inline">
          <input type="radio" name="weather" value={key} checked={scene.weather === key} /> {label}
        </label>
      ))
    }
  </fieldset>
  <!-- without the script, a plain form; with it, each choice is kept as it's made -->
  <button type="submit" class="quiet">Keep this</button>
</form>

<script>
  // A choice shows in the picture at once, wherever it is (on the page or in
  // its own small window: the same picture, found now, before it can move),
  // and is kept with the account in the background, through the same form.
  const form = document.querySelector<HTMLFormElement>(".scene-picker");
  const picture = document.querySelector<HTMLElement>(".little-one");
  if (form) {
    // removed, not hidden: the site's button style would show it anyway
    form.querySelector("button")?.remove();
    form.addEventListener("change", () => {
      const data = new FormData(form);
      if (picture) {
        picture.dataset.thing = String(data.get("thing"));
        picture.dataset.weather = String(data.get("weather"));
      }
      void fetch(form.action, { method: "POST", body: new URLSearchParams(data as unknown as string[][]), redirect: "manual" });
    });
  }
</script>

<style>
  .scene-picker {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .scene-picker fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
  }

  .scene-picker legend {
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .scene-picker label {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
</style>

---
import { dueLater } from "../lib/db";
import { localDate } from "../lib/summary";

// The reminder at the top of You: worries whose week has come, each linking
// to its enough on History, where the worry is kept and they can say how it
// looks now. Putting the reminder away leaves the worry where it is.
// Rendered only for the signed-in owner, from their own rows.
interface Props {
  personId: number;
}
const { personId } = Astro.props;
const due = dueLater(personId, localDate(Date.now()));
const back = Astro.url.pathname;
---

{
  due.length > 0 && (
    <section class="drawer" aria-labelledby="worry-heading">
      <h2 id="worry-heading">From a week ago</h2>
      <ul>
        {due.map((n) => (
          <li>
            <p class="drawer-note">A week ago you worried: “{n.text}”</p>
            <p class="drawer-about">
              about <a href={`/mine/all/?open=${n.enoughId}#enough-${n.enoughId}`}>{n.description}</a>.{" "}
              <a href={`/mine/all/?open=${n.enoughId}#worry-${n.id}`}>How does it look now?</a>
            </p>
            <form method="post" action="/put-away/">
              <input type="hidden" name="id" value={n.id} />
              <input type="hidden" name="back" value={back} />
              <button type="submit">Put it away</button>
            </form>
          </li>
        ))}
      </ul>
    </section>
  )
}

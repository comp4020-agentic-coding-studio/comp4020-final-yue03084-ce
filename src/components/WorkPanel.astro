---
import { ALARM_INTERVALS, ALARM_MAX_MINUTES, SNOOZE_MINUTES } from "../lib/limits";
import type { Outfit } from "../lib/collection";
import type { Scene } from "../lib/scene";
import type { WorkView } from "../lib/work";
import LittleOne from "./LittleOne.astro";

// "Start working" on Together, and the little one while you do. The owner's
// alone. Start can set an Enough alarm: after an interval, or at a clock
// time. When it rings, the overlay comes up on whatever page is open
// (AlarmPopup.astro, in the layout). Taking an ordinary break, coming back
// and Finish are in the status bar under the nav (StatusBar.astro), the one
// place for them on every page. All plain forms; the script adds the time
// zone.
interface Props {
  view: WorkView | null;
  scene?: Scene;
  outfit?: Outfit;
  // whether the sunflower is theirs to choose, so it's drawn ready
  sunflower?: boolean;
}
const { view, scene, outfit, sunflower } = Astro.props;
const resting = view?.state === "resting";
---

<section class="work" aria-labelledby="work-h">
  <h2 id="work-h">{view ? (resting ? "On a break" : "Building") : "Start working"}</h2>
  {
    !view ? (
      <form method="post" action="/work/" class="stack work-start">
        <input type="hidden" name="action" value="start" />
        <input type="hidden" name="tz" value="0" />
        <p class="hint">
          The little one works alongside you. Set an alarm for when you'd like to stop, and it will start to get sleepy
          then.
        </p>
        <fieldset class="choices">
          <legend>Enough alarm</legend>
          <label class="inline">
            <input type="radio" name="alarm" value="" checked /> No alarm
          </label>
          <label class="inline">
            <input type="radio" name="alarm" value="interval" /> After
            <select name="minutes" aria-label="Minutes">
              {ALARM_INTERVALS.map((m) => (
                <option value={m} selected={m === 90}>
                  {m} minutes
                </option>
              ))}
            </select>
          </label>
          <label class="inline">
            <input type="radio" name="alarm" value="interval" data-custom /> After
            <input
              type="number"
              name="minutes-custom"
              min="1"
              max={ALARM_MAX_MINUTES}
              inputmode="numeric"
              aria-label="Your own number of minutes"
              class="short"
            />
            minutes
          </label>
          <label class="inline">
            <input type="radio" name="alarm" value="clock" /> At
            <input type="time" name="clock" aria-label="Time of day" class="short" />
          </label>
        </fieldset>
        <button type="submit">Start working</button>
      </form>
    ) : (
      <div class="work-on">
        <div class="little-one-home">
          <LittleOne view={view} scene={scene} outfit={outfit} sunflower={sunflower} />
          <p class="hint away-note" hidden>The little one is in its own small window, beside whatever you're working on.</p>
        </div>
        <p class="work-status" aria-live="polite">
          {resting
            ? `You're on a break (${view.restLabel?.toLowerCase() ?? "resting"}). The little one is resting too.`
            : view.tiredness.sleepy
              ? "Past your alarm. The little one is getting sleepy."
              : view.alarmLabel
                ? `Your alarm is set ${view.alarmLabel}.`
                : "No alarm set."}
          {view.snoozes > 0 && ` You've asked for ${SNOOZE_MINUTES} more minutes ${view.snoozes} ${view.snoozes === 1 ? "time" : "times"}.`}
        </p>
        <div class="work-actions">
          <!-- only where the browser can open a window that stays on top (the script shows it) -->
          <button type="button" class="quiet keep-beside" hidden>Keep it beside you</button>
        </div>
      </div>
    )
  }
</section>

<script>
  // the browser's offset from UTC, so the alarm and the time bar use your clock
  for (const tz of document.querySelectorAll<HTMLInputElement>('form.work-start input[name="tz"]')) {
    tz.value = String(-new Date().getTimezoneOffset());
  }

  // starting: your own minutes count only if you chose that line, and asking
  // for notification permission happens here, on a click
  const start = document.querySelector<HTMLFormElement>("form.work-start");
  start?.addEventListener("submit", () => {
    const custom = start.querySelector<HTMLInputElement>("input[data-custom]");
    const typed = start.querySelector<HTMLInputElement>('input[name="minutes-custom"]');
    const select = start.querySelector<HTMLSelectElement>('select[name="minutes"]');
    if (custom?.checked && typed?.value && select) {
      const own = document.createElement("option");
      own.value = typed.value;
      select.append(own);
      select.value = typed.value;
    }
    const alarm = start.querySelector<HTMLInputElement>('input[name="alarm"]:checked');
    if (alarm?.value && "Notification" in window && Notification.permission === "default") {
      void Notification.requestPermission();
    }
  });

  // Keep it beside you: the little one, still working, in a small window that
  // stays on top of everything else (Document Picture-in-Picture, Chrome and
  // Edge only; elsewhere the button stays hidden). The picture itself moves
  // there, so it carries on mid-step; closing the window brings it back. It
  // closes when this page goes, on Go, I'm back or Finish, like the page.
  interface PipWindow extends Window {
    document: Document;
  }
  const pipApi = (window as unknown as { documentPictureInPicture?: { requestWindow(o: object): Promise<PipWindow> } })
    .documentPictureInPicture;
  const keep = document.querySelector<HTMLButtonElement>(".keep-beside");
  const home = document.querySelector<HTMLElement>(".little-one-home");
  const picture = home?.querySelector<HTMLElement>(".little-one");
  if (pipApi && keep && home && picture) {
    keep.hidden = false;
    const note = home.querySelector<HTMLElement>(".away-note");
    let pip: PipWindow | null = null;
    const back = () => {
      home.prepend(picture);
      if (note) note.hidden = true;
      keep.textContent = "Keep it beside you";
      pip = null;
    };
    keep.addEventListener("click", async () => {
      if (pip) return pip.close();
      // the picture is 112×60 pixels: three times that, and a little edge
      pip = await pipApi.requestWindow({ width: 352, height: 196 });
      // the page's styles go with it: the palette, the frames, the colours
      for (const s of document.querySelectorAll('style, link[rel="stylesheet"]')) pip.document.head.append(s.cloneNode(true));
      pip.document.title = "The little one";
      pip.document.body.classList.add("pip");
      pip.document.body.append(picture);
      if (note) note.hidden = false;
      keep.textContent = "Bring it back";
      pip.addEventListener("pagehide", back);
    });
  }
</script>

<style>
  .work {
    margin: 0 0 1.75rem;
    padding: var(--s3);
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--card);
  }

  /* the heading itself is in styles.css, with the break box's */
  .work h2 {
    margin: 0 0 0.4rem;
  }

  .work-start .choices label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .short {
    width: 7rem !important;
    min-height: 2.75rem;
  }

  select {
    min-height: 2.75rem;
    padding: 0.2rem 0.4rem;
    font: inherit;
    color: var(--fg);
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  /* in its own window: the picture alone, filling it */
  :global(body.pip) {
    margin: 0;
    padding: var(--s1);
    display: grid;
    place-items: center;
    min-height: 100vh;
    box-sizing: border-box;
    background: var(--bg);
  }

  :global(body.pip .little-one) {
    margin: 0;
  }

  :global(body.pip .little-one svg) {
    width: 100%;
  }

  .work-status {
    margin: 0.25rem 0 0.75rem;
    color: var(--muted);
  }

  .work-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .work-actions form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .take-break {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  button.quiet {
    min-height: 2.75rem;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--card);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }

  button.quiet:hover {
    background: var(--accent-soft);
  }

  .work-actions form:not(:has(.quiet)) button,
  .work-start button {
    min-height: 2.75rem;
  }
</style>

---
import BlocksScene from "../components/BlocksScene.astro";
import BreakBox from "../components/BreakBox.astro";
import Comments from "../components/Comments.astro";
import Replies from "../components/Replies.astro";
import Page from "../layouts/Page.astro";
import { sharedFeed } from "../lib/db";
import { BREAK_KINDS, COMMENT_PROMPT, PRESET_REPLIES, REPLY_MAX } from "../lib/limits";

// The public feed: moments when someone stopped. Only shared enoughs, and only
// their one-line description (CLAUDE.md: "Show stopping, never finishing").
// New ones and new replies arrive over /api/events without a reload.
const feed = sharedFeed();
const when = (iso: string) =>
  new Date(iso).toLocaleString("en-AU", { timeZone: "Australia/Sydney", dateStyle: "medium", timeStyle: "short" });
---

<Page>
  <BlocksScene />
  <h1>Put down for now</h1>
  <p>People who decided something was enough, and put it down.</p>
  <p><a class="button" href="/enough/">Call it enough</a></p>
  <BreakBox />

  <ol
    class="feed"
    id="feed"
    data-presets={JSON.stringify(PRESET_REPLIES)}
    data-prompt={COMMENT_PROMPT}
    data-max={REPLY_MAX}
    data-breaks={JSON.stringify(BREAK_KINDS)}
  >
    {
      feed.map((e) => (
        <li class="card" data-enough={e.id}>
          <p class="when">
            <span class="who">{e.name}</span> · <time datetime={e.createdAt}>{when(e.createdAt)}</time>
          </p>
          <p class="what">{e.description}</p>
          <p class="rest" data-rest={e.id}>
            {e.rest && (e.rest.back ? `Then took a break, and is ${BREAK_KINDS[e.rest.kind].back}.` : `Then ${BREAK_KINDS[e.rest.kind].going}.`)}
          </p>
          <Replies enoughId={e.id} counts={e.replies} canReply />
          <Comments enoughId={e.id} comments={e.comments} canComment />
        </li>
      ))
    }
  </ol>
  {feed.length === 0 && <p id="empty">Nobody has stopped yet. You could be the first.</p>}

  <script>
    import type { PublicEnough } from "../lib/db";

    const feed = document.getElementById("feed") as HTMLOListElement;
    const presets: Record<string, string> = JSON.parse(feed.dataset.presets ?? "{}");
    const prompt = feed.dataset.prompt ?? "";
    const max = Number(feed.dataset.max);
    const breakKinds: Record<string, { going: string; back: string }> = JSON.parse(feed.dataset.breaks ?? "{}");

    // the same words the card above renders for a break taken after an enough
    const restLine = (e: PublicEnough) =>
      !e.rest ? "" : e.rest.back ? `Then took a break, and is ${breakKinds[e.rest.kind]?.back}.` : `Then ${breakKinds[e.rest.kind]?.going}.`;

    // the same markup Comments.astro renders, from a PublicEnough's comments;
    // textContent throughout, so nobody's words become markup
    function comments(e: PublicEnough): HTMLDivElement {
      const box = document.createElement("div");
      box.className = "comments";
      box.dataset.comments = String(e.id);
      const list = document.createElement("ul");
      list.className = "comment-list";
      for (const c of e.comments) {
        const li = document.createElement("li");
        li.dataset.comment = String(c.id);
        const who = document.createElement("span");
        who.className = "who";
        who.textContent = c.name;
        const said = document.createElement("span");
        said.className = "said";
        said.textContent = c.text;
        const form = document.createElement("form");
        form.method = "post";
        form.action = "/report/";
        form.className = "report";
        const id = document.createElement("input");
        id.type = "hidden";
        id.name = "comment";
        id.value = String(c.id);
        const button = document.createElement("button");
        button.type = "submit";
        button.title = "Report this comment";
        button.textContent = "Report";
        form.append(id, button);
        li.append(who, " ", said, form);
        list.append(li);
      }
      const form = document.createElement("form");
      form.method = "post";
      form.action = "/comment/";
      form.className = "comment-box";
      const id = document.createElement("input");
      id.type = "hidden";
      id.name = "enough";
      id.value = String(e.id);
      const text = document.createElement("input");
      text.name = "text";
      text.maxLength = max;
      text.placeholder = prompt;
      text.required = true;
      text.autocomplete = "off";
      text.setAttribute("aria-label", `A comment, up to ${max} characters`);
      const send = document.createElement("button");
      send.type = "submit";
      send.textContent = "Send";
      form.append(id, text, send);
      box.append(list, form);
      return box;
    }

    const when = (iso: string) =>
      new Date(iso).toLocaleString("en-AU", { timeZone: "Australia/Sydney", dateStyle: "medium", timeStyle: "short" });

    // the same markup Replies.astro and the card above render, built from a
    // PublicEnough; textContent throughout, so nobody's words become markup
    function card(e: PublicEnough): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "card";
      li.dataset.enough = String(e.id);
      const meta = document.createElement("p");
      meta.className = "when";
      const who = document.createElement("span");
      who.className = "who";
      who.textContent = e.name;
      const time = document.createElement("time");
      time.dateTime = e.createdAt;
      time.textContent = when(e.createdAt);
      meta.append(who, " · ", time);
      const line = document.createElement("p");
      line.className = "what";
      line.textContent = e.description;
      const rest = document.createElement("p");
      rest.className = "rest";
      rest.dataset.rest = String(e.id);
      rest.textContent = restLine(e);
      const form = document.createElement("form");
      form.className = "replies";
      form.method = "post";
      form.action = "/reply/";
      form.dataset.replies = String(e.id);
      const hidden = document.createElement("input");
      hidden.type = "hidden";
      hidden.name = "enough";
      hidden.value = String(e.id);
      form.append(hidden);
      for (const [key, label] of Object.entries(presets)) {
        const button = document.createElement("button");
        button.type = "submit";
        button.name = "preset";
        button.value = key;
        button.dataset.preset = key;
        const count = document.createElement("span");
        count.className = "count";
        count.dataset.count = key;
        count.textContent = String(e.replies[key as keyof typeof e.replies] ?? 0);
        button.append(`${label} `, count);
        form.append(button);
      }
      li.append(meta, line, rest, form, comments(e));
      return li;
    }

    function updateCounts(e: PublicEnough) {
      const form = feed.querySelector<HTMLFormElement>(`form[data-replies="${e.id}"]`);
      if (!form) return;
      const rest = feed.querySelector<HTMLElement>(`[data-rest="${e.id}"]`);
      if (rest) rest.textContent = restLine(e);
      // redraw the comment list, keeping whatever someone is typing
      const box = feed.querySelector<HTMLDivElement>(`[data-comments="${e.id}"]`);
      if (box) {
        const fresh = comments(e);
        box.querySelector(".comment-list")?.replaceWith(fresh.querySelector(".comment-list")!);
      }
      for (const span of form.querySelectorAll<HTMLElement>("[data-count]")) {
        span.textContent = String(e.replies[span.dataset.count as keyof typeof e.replies] ?? 0);
      }
    }

    // replies go up with fetch, so the page doesn't reload; the new counts
    // come back on the stream like everyone else's
    feed.addEventListener("submit", async (event) => {
      const form = event.target as HTMLFormElement;
      // a comment, or a report: sent with fetch, the card comes back on the stream
      if (form.matches("form.comment-box, form.report")) {
        event.preventDefault();
        if (form.matches("form.report") && !confirm("Report this comment? It's hidden once a few people report it.")) return;
        const res = await fetch(form.action, { method: "POST", body: new URLSearchParams(new FormData(form) as never), headers: { accept: "application/json" } });
        if (form.matches("form.comment-box") && res.ok) {
          form.reset();
          updateCounts(await res.json());
        }
        if (form.matches("form.report") && res.ok) form.closest("li")?.classList.add("reported");
        return;
      }
      const button = (event as SubmitEvent).submitter as HTMLButtonElement | null;
      if (!form.matches("form.replies") || !button) return;
      event.preventDefault();
      const body = new URLSearchParams({ enough: form.dataset.replies ?? "", preset: button.value });
      const res = await fetch("/reply/", { method: "POST", body, headers: { accept: "application/json" } });
      if (res.ok) updateCounts(await res.json());
    });

    const source = new EventSource("/api/events");
    source.addEventListener("enough", (event) => {
      const e: PublicEnough = JSON.parse(event.data);
      if (feed.querySelector(`[data-enough="${e.id}"]`)) return;
      document.getElementById("empty")?.remove();
      feed.prepend(card(e));
    });
    source.addEventListener("reply", (event) => updateCounts(JSON.parse(event.data)));
    // how many people are on a break: a number, never who
    source.addEventListener("resting", (event) => {
      const { count } = JSON.parse(event.data) as { count: number };
      const p = document.getElementById("resting");
      if (!p) return;
      p.textContent =
        count === 0 ? (p.dataset.templateNone ?? "") : count === 1 ? (p.dataset.templateOne ?? "") : `${count} people are on a break right now.`;
    });
    // its owner deleted it: take the card away for everyone
    source.addEventListener("removed", (event) => {
      const { id } = JSON.parse(event.data) as { id: number };
      feed.querySelector(`[data-enough="${id}"]`)?.remove();
    });
  </script>
</Page>

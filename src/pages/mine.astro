---
import Page from "../layouts/Page.astro";
import { displayName, mine } from "../lib/db";
import { PRESET_REPLIES, type PresetKey, URGE_CHOICES } from "../lib/limits";
import { isHtml } from "../lib/notes";
import { describeSpan, parseSpans, roughly } from "../lib/spans";
import { currentPerson } from "../lib/person";

// Everything this person has said was enough, private fields included. It
// reads only their own rows, by their cookie.
const person = currentPerson(Astro.cookies);
const rows = person ? mine(person.id) : [];
// a small read-only copy of the time bar: from the hour before the first
// stretch to the hour after the last, each stretch in the crayon it was drawn with
const miniBar = (text: string) => {
  const spans = parseSpans(text) ?? [];
  if (spans.length === 0) return null;
  const from = Math.floor(spans[0].from / 60) * 60;
  const to = Math.ceil(spans[spans.length - 1].to / 60) * 60;
  const pct = (m: number) => ((m - from) / (to - from)) * 100;
  return { from: from / 60, to: to / 60, parts: spans.map((x) => ({ left: pct(x.from), width: pct(x.to) - pct(x.from) })) };
};
const when = (iso: string) =>
  new Date(iso).toLocaleString("en-AU", { timeZone: "Australia/Sydney", dateStyle: "medium", timeStyle: "short" });
---

<Page title="Mine">
  <h1>What you put down</h1>
  {person && <p>On the feed you show as {displayName(person.id)}. Only you can see this page.</p>}
  <p class="hint">
    {
      person?.username ? (
        <>
          Signed in as {person.username}. <a href="/account/">Account</a>
        </>
      ) : (
        <>
          This lives in this browser only. <a href="/account/">Create an account</a> to keep it and to write more.
        </>
      )
    }
  </p>
  {rows.length === 0 && <p>Nothing yet. <a href="/enough/">Call something enough.</a></p>}
  <ol class="feed mine">
    {
      rows.map((e) => (
        <li class="card" data-enough={e.id}>
          <p>
            <q>{e.description}</q> <span class="tag">{e.shared ? "shared" : "just you"}</span>
          </p>
          <p class="when">
            <time datetime={e.createdAt}>{when(e.createdAt)}</time>
          </p>
          <dl>
            {e.hours !== null && (
              <>
                <dt>Time spent</dt>
                <dd>
                  {e.spans
                    ? `${roughly(e.hours)}: ${(parseSpans(e.spans) ?? []).map(describeSpan).join(", ")}`
                    : `${e.hours} ${e.hours === 1 ? "hour" : "hours"}`}
                  {e.spans &&
                    (() => {
                      const bar = miniBar(e.spans);
                      return (
                        bar && (
                          <span class="minibar" aria-hidden="true" style={`--crayon: var(--c-${e.crayon ?? "clay"})`}>
                            <span class="minibar-strip">
                              {bar.parts.map((p) => (
                                <span class="minibar-part" style={`left: ${p.left}%; width: ${p.width}%`} />
                              ))}
                            </span>
                            <span class="minibar-ends">
                              <span>{bar.from}</span>
                              <span>{bar.to}</span>
                            </span>
                          </span>
                        )
                      );
                    })()}
                </dd>
              </>
            )}
            {e.feeling && (
              <>
                <dt>How it felt</dt>
                <dd>{e.feeling}</dd>
              </>
            )}
            {e.notes && (
              <>
                <dt>What you did and checked</dt>
                {/* cleaned on the way in (cleanNotes), so it's safe to render as HTML */}
                {isHtml(e.notes) ? <dd class="notes rich" set:html={e.notes} /> : <dd class="notes">{e.notes}</dd>}
              </>
            )}
          </dl>
          {e.shared && (
            <p class="replies-got">
              {(Object.entries(PRESET_REPLIES) as [PresetKey, string][])
                .filter(([key]) => e.replies[key])
                .map(([key, label]) => `${label} ×${e.replies[key]}`)
                .join(" · ") || "No replies yet."}
            </p>
          )}
          {e.comments.length > 0 && (
            <ul class="comment-list">
              {e.comments.map((c) => (
                <li>
                  <span class="who">{c.name}</span> <span class="said">{c.text}</span>
                </li>
              ))}
            </ul>
          )}
          {/* "I want to check it again": shows what they wrote down when they
              called it enough, and the note from the wall, then lets them
              choose. Either choice is recorded; neither stops them. Works as a
              plain <details> without script. */}
          <details class="urge">
            <summary>I want to check it again</summary>
            <div class="urge-body">
              <p>You called this enough on {when(e.createdAt)}.</p>
              {e.notes && (
                <>
                  <p class="hint">What you did and checked then:</p>
                  {isHtml(e.notes) ? <div class="notes rich then" set:html={e.notes} /> : <p class="notes then">{e.notes}</p>}
                </>
              )}
              {e.hours !== null && <p class="hint">Time you put in: {e.spans ? roughly(e.hours) : `${e.hours} hours`}.</p>}
              <p class="wall">Live with imperfection.</p>
              <form method="post" action="/urge/" class="urge-choices">
                <input type="hidden" name="enough" value={e.id} />
                <button type="submit" name="choice" value="let_go" class="let-go">
                  {URGE_CHOICES.let_go}
                </button>
                <button type="submit" name="choice" value="checked" class="check-anyway">
                  {URGE_CHOICES.checked}
                </button>
              </form>
            </div>
          </details>
          {(e.urges.letGo > 0 || e.urges.checked > 0) && (
            <p class="urge-tally">
              Wanted to check it again {e.urges.letGo + e.urges.checked}{" "}
              {e.urges.letGo + e.urges.checked === 1 ? "time" : "times"}; let it go {e.urges.letGo}.
            </p>
          )}
          {/* delete asks once more before it goes: a <details> needs no script */}
          <details class="delete">
            <summary>Delete</summary>
            <form method="post" action="/delete/">
              <input type="hidden" name="enough" value={e.id} />
              <span>This can't be undone{e.shared ? ", and it comes off the feed for everyone" : ""}.</span>
              <button type="submit" class="danger">Delete it</button>
            </form>
          </details>
        </li>
      ))
    }
  </ol>
  <script>
    // with script, the urge opens as a dialog over the page rather than in place
    for (const details of document.querySelectorAll<HTMLDetailsElement>("details.urge")) {
      const body = details.querySelector<HTMLElement>(".urge-body");
      const summary = details.querySelector("summary");
      if (!body || !summary) continue;
      const dialog = document.createElement("dialog");
      dialog.className = "urge-dialog";
      dialog.setAttribute("aria-label", "You want to check it again");
      const close = document.createElement("button");
      close.type = "button";
      close.className = "close";
      close.setAttribute("aria-label", "Close");
      close.textContent = "×";
      close.addEventListener("click", () => dialog.close());
      dialog.append(close, body);
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      const open = document.createElement("button");
      open.type = "button";
      open.className = "urge-open";
      open.textContent = summary.textContent ?? "";
      open.addEventListener("click", () => dialog.showModal());
      details.replaceWith(open, dialog);
    }
  </script>
</Page>
